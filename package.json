{
  "name": "@apnex/caller-identity",
  "version": "0.1.1",
  "private": true,
  "description": "Establish the principal each request comes from, from the evidence its caller presented and the host's rules.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/caller-identity.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh"
  },
  "devDependencies": {
    "@agp/core": "file:../agp/packages/core",
    "@agp/node": "file:../agp/packages/node",
    "@agp/transport-loopback": "file:../agp/packages/transport-loopback",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@agp/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@agp/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@apnex/shape-check": "https://github.com/apnex/shape-check/releases/download/v0.1.0/apnex-shape-check-0.1.0.tgz"
  }
}
